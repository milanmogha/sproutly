# Sproutly backend configuration.
#
# Copy to `.env` and fill in every value marked FILL IN. The real `.env` is
# gitignored and never committed.

# ── App ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Origins allowed to call this API from a browser. The Next.js web client runs
# on 3001 in dev (3000 is taken by this server). `*` allows everything — fine
# for local work, tighten in production.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# ── Database ──────────────────────────────────────────────────────────
MONGODB_URI=                      # FILL IN — mongodb+srv://user:pass@host
MONGODB_DB_NAME=sproutly

# ── Auth ──────────────────────────────────────────────────────────────
JWT_SECRET=                       # FILL IN — long random string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=               # FILL IN — different long random string
JWT_REFRESH_EXPIRES_IN=365d
MAX_SESSIONS_PER_USER=5
REFRESH_GRACE_SECONDS=60

# ── Storage (uploads: gallery images, documents) ──────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_FILE_SIZE=10485760
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# ── WhatsApp (parent login codes) ─────────────────────────────────────
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=buzzflow
WHATSAPP_API_URL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=            # FILL IN if WHATSAPP_ENABLED=true
WHATSAPP_BUSINESS_ACCOUNT_ID=
BUZZFLOW_SEND_URL=
BUZZFLOW_TIMEOUT_MS=10000

# ── Seeded super admin (npm run seed) ─────────────────────────────────
SUPER_ADMIN_EMAIL=                # FILL IN
SUPER_ADMIN_PASSWORD=             # FILL IN

# Where password-reset and invite links point — the Next.js web client.
WEB_APP_URL=http://localhost:3001
INVITE_TTL_HOURS=72
RESET_TTL_MINUTES=60

# ── Mail ──────────────────────────────────────────────────────────────
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=                        # FILL IN
SMTP_PASS=                        # FILL IN — app password, not the account password
MAIL_FROM=Sproutly <your-smtp-account@example.com>   # must be an address SMTP_USER may send as; a domain with no DNS (e.g. .local) fails DMARC and lands in spam

# ── Push (mobile clients; the web client does not use FCM) ────────────
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# ── Encryption (per-school Razorpay keys are stored encrypted) ────────
ENCRYPTION_KEY=                   # FILL IN — 32-byte key

# ── Platform billing (what schools pay Sproutly) ─────────────────────
PLATFORM_RAZORPAY_KEY_ID=         # FILL IN
PLATFORM_RAZORPAY_KEY_SECRET=     # FILL IN
PLATFORM_RAZORPAY_WEBHOOK_SECRET= # FILL IN

# ── Reverse proxy ─────────────────────────────────────────────────────
# Rate limiting keys on the client IP. Behind nginx / a load balancer /
# a tunnel, set this to the number of proxy hops (usually 1) or every caller
# shares one bucket.
TRUST_PROXY_HOPS=0
